# JobFinder backend configuration
# Copy this file to .env and fill in your values.

# Gmail SMTP (used in Etapa 4 — pode deixar vazio por enquanto)
# Crie uma "Senha de app" em https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
DEFAULT_RECIPIENT=

# CORS — origem do frontend em dev (Vite usa 5173 por padrão)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Caminho do diretório de dados (relativo ao backend/, ou absoluto)
DATA_DIR=data
